# ZIV app configuration. One explicit backend per build (see packages/config/src/backend.ts).
#   demo : fictional members on the device, nothing leaves it (default).
#   test : Supabase test project (web preview). Real accounts + demo profiles badged.
#   api  : ZIV API (NestJS). The only backend allowed in production.
EXPO_PUBLIC_BACKEND=demo
# development | preview | production. production requires BACKEND=api and an https API address.
EXPO_PUBLIC_APP_ENV=development
# ZIV API address (BACKEND=api). Development may use http://<computer-ip>:3000; production never localhost.
EXPO_PUBLIC_API_URL=
# Supabase test project (BACKEND=test only). The publishable key is public by design; never put a service key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
