# Copy to .env. Every external service has an honest demo fallback.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kapara:kapara@localhost:5432/kapara
JWT_SECRET=change-me-to-a-long-random-string
# Optional. Without these, Live runs in DEMO mode (simulated call, clearly labelled).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional. Without it, presence is kept in memory (single instance only).
REDIS_URL=
# Optional. Email sign-in codes are sent with Resend (https://resend.com).
# Without them, development returns the code in the response (labelled demo) and production refuses.
RESEND_API_KEY=
MAIL_FROM=
# Optional. Sign in with Apple / Google: comma-separated accepted audiences (bundle id, client ids).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
