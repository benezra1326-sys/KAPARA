# Copy to .env. Every external service has an honest demo fallback.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kapara:kapara@localhost:5432/kapara
JWT_SECRET=change-me-to-a-long-random-string
# Optional. Without these, Live runs in DEMO mode (simulated call, clearly labelled).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional. Without it, presence is kept in memory (single instance only).
REDIS_URL=
# Optional. Email sign-in codes are sent with Resend (https://resend.com).
# Without them, development returns the code in the response (labelled demo) and production refuses.
RESEND_API_KEY=
MAIL_FROM=
# Optional. Sign in with Apple / Google: comma-separated accepted audiences (bundle id, client ids).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Optional. Profile photos in S3-compatible storage (AWS S3, Cloudflare R2, Scaleway, MinIO).
# Without them, development stores photos on this API's disk (UPLOAD_DIR) and production refuses uploads.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
UPLOAD_DIR=.uploads
# Base URL of this API as phones reach it (local photo storage only), e.g. http://192.168.1.20:3000
PUBLIC_API_URL=
