// ZIV data model. Geography uses PostGIS through explicit SQL
// (see src/crossed and prisma/migrations/*_postgis). Prisma sees the columns
// as Unsupported and never reads raw coordinates back into the app.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  woman
  man
  nonbinary
}

enum MatchStatus {
  pending
  matched
  closed
}

enum IntroStatus {
  proposed
  accepted_by_a
  accepted_by_b
  connected
  declined
  expired
}

model Region {
  code       String   @id // "fr-paris"
  country    String
  city       String
  timezone   String
  locale     String
  launched   Boolean  @default(false)
  center     Unsupported("geography(Point,4326)")?
  users      User[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  locale        String    @default("fr")
  regionCode    String
  region        Region    @relation(fields: [regionCode], references: [code])
  isDemo        Boolean   @default(false)
  paused        Boolean   @default(false)
  shabbatMode   Boolean   @default(false)
  verifiedAt    DateTime?
  profile       Profile?
  preferences   Preferences?
  privacy       PrivacySettings?
  consents      SensitiveConsent[]
  likesSent     Like[]    @relation("likeFrom")
  likesReceived Like[]    @relation("likeTo")
  sightings     Sighting[]
  blocksMade    Block[]   @relation("blocker")
  blocksGot     Block[]   @relation("blocked")
  feedback      RecommendationFeedback[]
  conversations ConversationMember[]
  messages      Message[]
  sensitiveZones SensitiveZone[]
  shabbat        ShabbatSettings?
  /// Approximate home area for "Pour toi" distance, snapped to ~1 km. Never returned.
  homeArea      Unsupported("geography(Point,4326)")?
  identities    AuthIdentity[]
  sessions      Session[]
  dailyPicks    DailyPick[]
}

model Profile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName  String
  birthDate  DateTime @db.Date
  gender     Gender
  headline   String?
  languages  String[]
  /// Structured, nuanced Jewish-life answers (see @kapara/shared JewishLife).
  /// Each field holds { value, preferNotToSay, note, visibility, useForMatching }.
  jewishLife Json     @default("{}")
  prompts    Json     @default("[]")
  photos     Photo[]
  updatedAt  DateTime @updatedAt
}

model Photo {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  url       String
  /// Object key in photo storage (S3 or local fallback). Null for demo illustrations.
  storageKey String? @unique
  caption   String?
  position  Int
  isDemo    Boolean @default(false)
}

model Preferences {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ageMin        Int      @default(25)
  ageMax        Int      @default(40)
  maxDistanceKm Int      @default(25)
  genders       Gender[]
  dealbreakers  Json     @default("{}")
  soft          Json     @default("{}")
}

/// Explicit, revocable consent for processing a sensitive field (GDPR art. 9).
model SensitiveConsent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  field      String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  /// Version of the explanation text the member accepted.
  policyVersion String?
  @@unique([userId, field])
}

model PrivacySettings {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  crossedEnabled  Boolean @default(false)
  liveEnabled     Boolean @default(false)
  /// "nobody" | "matches" | "members"
  liveCallsFrom   String  @default("matches")
  introducible    Boolean @default(true)
}

/// Coarse, short-lived location samples for "Croisés". Only stored when the
/// member enabled the feature; snapped to a grid; purged after the window.
model Sighting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  cell      Unsupported("geography(Point,4326)")
  @@index([userId, at])
}

model Like {
  id         String      @id @default(cuid())
  fromId     String
  toId       String
  from       User        @relation("likeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User        @relation("likeTo", fields: [toId], references: [id], onDelete: Cascade)
  targetKind String // "photo" | "prompt"
  targetId   String
  comment    String?
  status     MatchStatus @default(pending)
  createdAt  DateTime    @default(now())
  @@unique([fromId, toId])
}

model RecommendationFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  /// "more_like_this" | "not_for_me"
  signal    String
  /// Optional voluntary reason for "not_for_me" (too_far, values_differ…)
  reason    String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Introduction {
  id          String      @id @default(cuid())
  introducerId String
  personAId   String
  personBId   String
  note        String
  status      IntroStatus @default(proposed)
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
  /// Proposals lapse quietly; the clock does not run during Shabbat mode.
  expiresAt   DateTime?
  @@index([personAId, status])
  @@index([personBId, status])
  @@index([introducerId])
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  /// "like" | "introduction" | "live" | "other"
  origin    String               @default("other")
  introductionId String?         @unique
  /// Set when a member closes the conversation or blocks the other.
  closedAt  DateTime?
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  @@index([conversationId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  details    String?
  /// "profile" | "conversation" | "live" | "crossed" | "introduction"
  context    String   @default("profile")
  /// "open" | "reviewed" | "actioned"
  status     String   @default("open")
  createdAt  DateTime @default(now())
  @@index([status, createdAt])
}

model CallLog {
  id        String    @id @default(cuid())
  callerId  String
  calleeId  String
  state     String
  demo      Boolean
  createdAt DateTime  @default(now())
  endedAt   DateTime?
}

/// Places where "Croisés" never records anything (home, work…). Stored
/// snapped to the same grid as sightings and never returned to the app.
model SensitiveZone {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "home" | "work" | "other"
  kind      String
  cell      Unsupported("geography(Point,4326)")
  createdAt DateTime @default(now())
  @@index([userId])
}

/// Optional Shabbat mode (User.shabbatMode is the on/off switch). Private:
/// never exposed to other members, only used to pause features.
model ShabbatSettings {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  includeHolidays    Boolean @default(true)
  candleLightingMins Int     @default(18)
  /// null = nightfall (sun 8.5° below the horizon)
  havdalahMins       Int?
}

/// Email one-time codes. Only an HMAC of the code is stored.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  @@index([email, createdAt])
}

/// External sign-in identities (Apple, Google) linked to a member.
model AuthIdentity {
  provider  String // "apple" | "google"
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([provider, subject])
  @@index([userId])
}

/// Refresh-token sessions. Tokens are opaque, stored hashed, rotated on use;
/// reuse of a rotated token revokes the whole family.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([userId])
  @@index([familyId])
}

/// "Pour toi" daily selection, persisted so the list is finite and stable for the day.
model DailyPick {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD in the member's region timezone
  subjectId String
  position  Int
  score     Float
  reasons   Json     @default("[]")
  /// "new" | "liked" | "dismissed"
  state     String   @default("new")
  createdAt DateTime @default(now())
  @@id([userId, day, subjectId])
  @@index([userId, createdAt])
}
